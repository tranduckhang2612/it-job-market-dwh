# Local Python environments
venv/
.venv/
env/

# Generated Python files
__pycache__/
*.py[cod]

# Local environment settings
.env
.env.*
!.env.example
!.env.sample

# ITviec login cookies and saved browser sessions
cookie.txt
cookie_*.txt
cookies.txt
cookies*.json
.itviec_auth*.json
.itviec_auth_*.tmp

# TopDev login cookies and local dump files
topdev_cookie*.txt
topdev_sample.json
topdev_normalized.json
*_sample.json
*_normalized.json

# Keep generated database snapshots, dumps and binary reports local.
# Only Markdown review documents belong in version control under reports/.
reports/**
!reports/**/
!reports/**/*.md
